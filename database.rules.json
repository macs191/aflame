{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "uid": { ".validate": "newData.isString() && newData.val() === $uid" },
        "email": { ".validate": "newData.isString() && newData.val().length > 3" },
        "displayName": { ".validate": "newData.isString() && newData.val().length > 0" },
        "role": { ".validate": "newData.val() === 'user' || newData.val() === 'admin'" },
        "subscriptionStatus": { ".validate": "newData.val() === 'active' || newData.val() === 'inactive' || newData.val() === 'expired' || newData.val() === 'pending'" }
      }
    }
  }
}
