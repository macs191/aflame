rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isSubscriber() {
      return isSignedIn() && (
        isAdmin() || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscriptionStatus == 'active'
        )
      );
    }

    // Public Media Collections (Read by Active Subscribers, Managed by Admins)
    match /channels/{channelId} {
      allow read: if isSubscriber();
      allow write: if isAdmin();
    }

    match /movies/{movieId} {
      allow read: if isSubscriber();
      allow write: if isAdmin();
    }

    match /series/{seriesId} {
      allow read: if isSubscriber();
      allow write: if isAdmin();

      match /episodes/{episodeId} {
        allow read: if isSubscriber();
        allow write: if isAdmin();
      }
    }

    // Categories and Plans
    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // User Profiles & Private Sub-collections
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // User Watch History (Private)
      match /history/{historyId} {
        allow read, write: if isOwner(userId);
      }

      // User Favorites (Private)
      match /favorites/{favoriteId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Contact Submissions
    match /contacts/{contactId} {
      allow create: if true; // Public contact form
      allow read, write: if isAdmin();
    }
  }
}
