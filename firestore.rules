rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(userId) { return signedIn() && request.auth.uid == userId; }
    function admin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if owner(userId) || admin();
      allow create: if owner(userId) && request.resource.data.uid == userId && request.resource.data.role == 'user';
      allow update: if admin() || (owner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if admin();
      match /history/{historyId} { allow read, write: if owner(userId); }
      match /favorites/{favoriteId} { allow read, write: if owner(userId); }
    }

    match /channels/{id} { allow read: if admin() || (signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscriptionStatus == 'active'); allow write: if admin(); }
    match /movies/{id} { allow read: if admin() || (signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscriptionStatus == 'active'); allow write: if admin(); }
    match /series/{id} { allow read: if admin() || (signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscriptionStatus == 'active'); allow write: if admin(); match /episodes/{episodeId} { allow read: if admin() || (signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscriptionStatus == 'active'); allow write: if admin(); } }
    match /categories/{id} { allow read: if signedIn(); allow write: if admin(); }
    match /plans/{id} { allow read: if signedIn(); allow write: if admin(); }
    match /contacts/{id} { allow create: if true; allow read, update, delete: if admin(); }
  }
}
